{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "types": ["node"],

    "noEmit": true,
    "skipLibCheck": true,

    "strict": true
  },
  
"ignoreDeprecations": "6.0",
  "include": [
    "vite.config.ts",
    ".storybook/main.ts"
  ]
}