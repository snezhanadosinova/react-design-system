{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": ["src/index.ts", "src/components/**/*.tsx", "src/components/**/*.ts", "src/providers/**/*.tsx", "src/providers/**/*.ts", "src/hooks/**/*.ts", "src/themes/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["src/**/*.stories.tsx", "src/pages/**", "src/main.tsx", "src/stories/**"]
}
